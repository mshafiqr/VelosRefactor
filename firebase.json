{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "VELOS_REVAMP_BRIEF.md",
      "CLAUDE.md",
      "AUTHENTICATION USER MANUAL.md",
      "migrate.js",
      "seed-bnu9974-downtime.js",
      "velos-read-audit.js",
      "firestore.rules",
      "storage.rules",
      "package.json",
      "package-lock.json",
      "playwright.config.js",
      "playwright.emulator.config.js",
      "tests/**",
      "test-results/**",
      "playwright-report/**",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "firestore-debug.log",
      "ui-debug.log"
    ],
    "cleanUrls": true,
    "trailingSlash": false
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
